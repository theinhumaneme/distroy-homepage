---
import { existsSync } from 'node:fs';
const hasResume = existsSync(new URL('../../public/kalyan-mudumby-resume.pdf', import.meta.url));
import { hero, person } from '../data/content';
import { tokenize } from '../lib/build';

const nameToks = tokenize(person.name);
// break the name onto two lines at the first token that starts a new word
const breakAt = nameToks.findIndex((t, i) => i > 0 && t.t.startsWith(' '));
const lines = [nameToks.slice(0, breakAt), nameToks.slice(breakAt)];
---

<section id="top" class="hero" data-stage="top" data-field="0" aria-labelledby="hero-name">
  <div class="wrap hero-in">
    <p class="prompt mono" aria-hidden="true">
      <span class="who">you</span>
      <span class="gt">›</span>
      <span class="q" data-typed={hero.prompt}>{hero.prompt}</span><span class="caret"></span>
      <span class="meta">a name, in tokens</span>
    </p>

    <h1 id="hero-name" class="name" aria-label={person.name}>
      {
        lines.map((line, li) => (
          <span class="line" aria-hidden="true">
            {line.map((t, i) => (
              <span class={`tok c${((li * 3 + i) % 5) + 1}`} title={`"${t.t.replace(' ', '␣')}" → token ${t.id}`} data-name-tok>
                {li > 0 && i === 0 ? t.t.trimStart() : t.t}
                <span class="tid mono">{t.id}</span>
              </span>
            ))}
          </span>
        ))
      }
    </h1>

    <p class="statement" data-hero-statement>
      {
        hero.statement.map((part) =>
          part.em ? (
            <span class="nw">
              <strong class={`kind tok c${part.em}`}>{part.text}</strong>
              {part.tail}
            </span>
          ) : (
            part.text
          ),
        )
      }
    </p>

    <div class="foot" data-hero-late>
      <p class="intro">{hero.intro}</p>
      <div class="side">
        <p class="avail"><span class="dot" aria-hidden="true"></span>{hero.availability}</p>
        <p class="meta-line mono">{hero.meta.map((item) => <span>{item}</span>)}</p>
        <div class="ctas">
          <a class="btn primary" href="#work">View selected work <span class="arr">↓</span></a>
          {hasResume && <a class="btn" href={person.resume} download>Download resume <span class="arr">↓</span></a>}
          <a class="btn" href="#contact">Get in touch <span class="arr">→</span></a>
        </div>
      </div>
    </div>
  </div>

  <a class="scroll mono" href="#work">
    <span class="bar" aria-hidden="true"><i></i></span>
    Explore the work
  </a>
</section>

<style>
  .hero {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--hud-h) + 3vh);
    padding-bottom: 10vh;
  }
  .hero-in {
    display: grid;
    gap: clamp(14px, 2.4vh, 28px);
  }

  .prompt {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    max-width: 100%;
    margin: 0;
    padding: 9px 14px 9px 9px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line-2);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .who {
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mono);
    padding: 3px 7px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink-3);
  }
  .gt {
    color: var(--t2);
  }
  .caret {
    width: 0.55em;
    height: 1.15em;
    margin-left: -6px;
    background: var(--t2);
    border-radius: 1px;
    /* blinks while the question is asked, then settles */
    animation: blink 1s steps(1) 3;
  }
  .meta {
    margin-left: 10px;
    padding-left: 12px;
    border-left: 1px solid var(--line-2);
    color: var(--ink-3);
    font-size: var(--fs-micro);
    white-space: nowrap;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .name {
    display: grid;
    row-gap: 0.26em;
    font-size: var(--fs-display);
    line-height: 0.92;
    letter-spacing: var(--tr-display);
    font-weight: var(--fw-display);
    margin-top: 0.1em;
  }
  .line {
    display: block;
    white-space: nowrap;
  }
  .name .tok {
    position: relative;
    display: inline-block;
    padding: 0 0.02em 0.04em;
    margin-right: 0.035em;
    border-radius: 0.09em;
    box-shadow: inset 0 -0.035em 0 color-mix(in oklab, var(--c) 80%, transparent);
    background: linear-gradient(180deg, color-mix(in oklab, var(--c) 4%, transparent), color-mix(in oklab, var(--c) 15%, transparent));
    transition: background 0.4s;
  }
  .name .tok:hover {
    background: color-mix(in oklab, var(--c) 22%, transparent);
  }
  .tid {
    position: absolute;
    left: 0.06em;
    bottom: -1.5em;
    font-size: max(10px, 0.085em);
    letter-spacing: var(--tr-mono);
    font-weight: var(--fw-body);
    color: color-mix(in oklab, var(--c) 85%, var(--ink));
    opacity: 0.85;
  }

  .statement {
    margin-top: clamp(18px, 3.4vh, 40px);
    max-width: 26ch;
    font-size: clamp(1.8rem, 3.5vw, 3.3rem);
    line-height: 1.04;
    letter-spacing: var(--tr-head);
    font-weight: var(--fw-head);
    text-wrap: balance;
  }
  /* The three kinds of work read as tokens, like the name above them: same
     weight, one hue each, so none outranks the others */
  .statement {
    color: var(--ink-2);
  }
  .kind {
    color: var(--ink);
    font-weight: inherit;
    white-space: nowrap;
    padding: 0 0.06em;
    margin: 0 -0.02em;
    border-radius: 0.12em;
    background: color-mix(in oklab, var(--c) 18%, transparent);
    box-shadow: inset 0 -0.07em 0 color-mix(in oklab, var(--c) 80%, transparent);
  }

  /* keeps the comma with its noun when the line wraps */
  .nw {
    white-space: nowrap;
  }

  .avail {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    color: var(--ink);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .avail .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--t2);
    transform: translateY(-1px);
  }

  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: end;
    margin-top: clamp(4px, 2vh, 20px);
  }
  .intro {
    font-size: var(--fs-lede);
    color: var(--ink-2);
    max-width: 48ch;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .side {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .meta-line {
    font-size: var(--fs-xs);
    color: var(--ink-3);
    letter-spacing: var(--tr-mono);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mono);
    color: var(--ink-3);
  }
  .scroll .bar {
    position: relative;
    width: 1px;
    height: 34px;
    background: var(--line-2);
    overflow: hidden;
  }
  .scroll .bar i {
    position: absolute;
    left: 0;
    top: -40%;
    width: 1px;
    height: 40%;
    background: var(--t2);
    animation: drip 2.2s var(--ease-io) infinite;
  }
  @keyframes drip {
    to {
      top: 110%;
    }
  }

  /* Held back until the intro takes over (set in index.astro, lifted by the
     script below, or after 2.5s if the script never runs) */
  :global(html.intro :is(#field, .hud, .hero .prompt, .hero [data-name-tok], .hero .tid, .hero [data-hero-statement], .hero [data-hero-late], .hero .scroll)) {
    opacity: 0 !important;
  }

  @media (max-width: 900px) {
    .foot {
      grid-template-columns: 1fr;
    }
    .meta,
    .scroll,
    .tid {
      display: none;
    }
    .name {
      row-gap: 0.12em;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  gsap.registerPlugin(SplitText);

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.querySelector('.hero');

  const html = document.documentElement;

  if (root && !reduce) {
    const q = root.querySelector<HTMLElement>('[data-typed]')!;
    const full = q.dataset.typed ?? '';
    const prompt = root.querySelector<HTMLElement>('.prompt');
    const toks = [...root.querySelectorAll<HTMLElement>('[data-name-tok]')];
    const statement = root.querySelector<HTMLElement>('[data-hero-statement]')!;
    const late = root.querySelectorAll<HTMLElement>('[data-hero-late]');
    const split = SplitText.create(statement, { type: 'words', mask: 'words' });
    const kinds = statement.querySelectorAll<HTMLElement>('.kind');

    if (html.classList.contains('intro')) {
      // The page answers its own question. The field gathers, the question is
      // typed, a beat passes, then the answer streams in a token at a time and
      // the page chrome arrives last.
      const ids = toks.map((t) => t.querySelector<HTMLElement>('.tid'));
      const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });

      // Kept short: the buttons and availability are readable within ~1.7s.
      tl.from('#field', { opacity: 0, duration: 1.8, ease: 'power2.out', clearProps: 'opacity' }, 0);
      tl.from(prompt, { opacity: 0, y: 10, duration: 0.6 }, 0.1);

      // keystrokes at an uneven, human pace, with a longer gap after spaces
      q.textContent = '';
      let at = 0.3;
      for (let i = 0; i < full.length; i++) {
        tl.call(() => void (q.textContent = full.slice(0, i + 1)), [], at);
        at += 0.026 + ((i * 37) % 7) * 0.004 + (full[i] === ' ' ? 0.05 : 0);
      }
      at += 0.22; // the pause before an answer

      toks.forEach((t, i) => {
        tl.from(t, { opacity: 0, y: '0.18em', duration: 0.8 }, at + i * 0.07);
        if (ids[i]) tl.from(ids[i], { opacity: 0, y: 6, duration: 0.5 }, at + i * 0.07 + 0.15);
      });
      at += 0.3; // the statement follows the name, overlapping it
      tl.from(split.words, { yPercent: 110, duration: 0.9, stagger: 0.035 }, at);
      tl.from(kinds, { opacity: 0, duration: 0.7, stagger: 0.12, ease: 'power2.out' }, at + 0.1);
      at += 0.3;
      tl.from(late, { opacity: 0, y: 14, duration: 0.8 }, at);
      tl.from(['.hud', '.hero .scroll'], { opacity: 0, duration: 0.6, ease: 'power2.out', stagger: 0.1, clearProps: 'opacity' }, at);

      // the from-states are set; hand the elements over from the stylesheet
      html.classList.remove('intro');

      // anyone who scrolls, taps or types is in a hurry: fast-forward
      const hurry = () => {
        tl.timeScale(6);
        ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((e) => removeEventListener(e, hurry));
      };
      ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((e) => addEventListener(e, hurry, { passive: true }));
    } else {
      // Deep links: everything enters together within a second.
      const typed = { n: 0 };
      q.textContent = '';
      gsap.to(typed, {
        n: full.length,
        duration: full.length * 0.035,
        ease: 'none',
        delay: 0.15,
        onUpdate: () => void (q.textContent = full.slice(0, Math.round(typed.n))),
      });
      gsap.from(toks, { opacity: 0, y: '0.2em', duration: 0.9, ease: 'expo.out', stagger: 0.06, delay: 0.05 });
      gsap.from(split.words, { yPercent: 110, duration: 1, ease: 'expo.out', stagger: 0.03, delay: 0.2 });
      gsap.from(late, { opacity: 0, y: 18, duration: 0.9, ease: 'expo.out', delay: 0.3 });
    }
  }
</script>
