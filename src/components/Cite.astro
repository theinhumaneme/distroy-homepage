---
// Renders a citation chip only when the source has a public URL.
import { sourceById } from '../data/content';
interface Props {
  src?: string;
}
const s = Astro.props.src ? sourceById(Astro.props.src) : undefined;
const tip = s ? `${s.label} · ${s.detail}` : '';
---

{
  s?.url && (
    <a class="cite" href={s.url} target="_blank" rel="noopener" data-tip={tip} aria-label={`Source: ${tip}`}>
      ↗
    </a>
  )
}
