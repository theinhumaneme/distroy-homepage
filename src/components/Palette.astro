---
// Type-anywhere navigation: start typing on any page (or press ⌘K / Ctrl K)
// to jump to a section, a project, a blog post or a contact link.
import { existsSync } from 'node:fs';
import { cases, chapters, moreWork, person } from '../data/content';
import { getPosts, postHref } from '../lib/blog';

interface Props {
  base?: string;
}
const { base = '' } = Astro.props;
const hasResume = existsSync(new URL('../../public/kalyan-mudumby-resume.pdf', import.meta.url));
const posts = await getPosts();

type Item = { t: string; k: string; href: string; ext?: boolean; dl?: boolean };
const items: Item[] = [
  ...chapters.filter((c) => c.id !== 'top').map((c) => ({ t: c.label, k: 'Section', href: `${base}#${c.id}` })),
  ...cases.map((c) => ({ t: c.title, k: 'Project', href: `${base}#${c.anchor}` })),
  ...moreWork.map((m) => ({ t: m.title, k: 'Project', href: `${base}#${m.anchor}` })),
  { t: 'Blog', k: 'Page', href: '/blog/' },
  ...posts.map((p) => ({ t: p.data.title, k: 'Post', href: postHref(p) })),
  ...(hasResume ? [{ t: 'Download resume', k: 'Link', href: person.resume, dl: true }] : []),
  { t: `Email ${person.email}`, k: 'Link', href: `mailto:${person.email}` },
  { t: 'LinkedIn', k: 'Link', href: person.linkedin, ext: true },
  { t: 'GitHub', k: 'Link', href: person.github, ext: true },
];
---

<dialog class="pal" data-pal aria-label="Jump to">
  <div class="pal-in">
    <div class="pal-field">
      <svg class="pal-ico" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.6" /><path d="m10.4 10.4 3.4 3.4" /></svg>
      <input
        data-pal-q
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="pal-list"
        aria-autocomplete="list"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="Jump to a section, project or post"
      />
      <kbd class="pal-kbd">esc</kbd>
    </div>
    <ul class="pal-list" id="pal-list" role="listbox" data-pal-list></ul>
    <p class="pal-hint">Start typing anywhere on the site to open this · ↑ ↓ to move · Enter to go</p>
  </div>
</dialog>
<script type="application/json" data-pal-items set:html={JSON.stringify(items)} />

<style>
  .pal {
    width: min(560px, calc(100vw - 32px));
    margin: 14vh auto auto;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 14px;
    background: var(--bg-1);
    color: var(--ink);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / calc(0.8 * var(--shadow-k)));
  }
  .pal::backdrop {
    background: rgb(var(--bg-rgb) / 0.55);
    backdrop-filter: blur(3px);
  }
  .pal-field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border-bottom: 1px solid var(--line);
  }
  .pal-ico {
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .pal-field input {
    flex: 1;
    min-width: 0;
    height: 52px;
    border: 0;
    outline: 0;
    background: none;
    font: inherit;
    font-size: var(--fs-body);
    color: var(--ink);
  }
  .pal-field input::placeholder {
    color: var(--ink-3);
  }
  .pal-kbd {
    font-family: var(--f-mono);
    font-size: var(--fs-micro);
    padding: 2px 6px;
    border-radius: 5px;
    border: 1px solid var(--line-2);
    color: var(--ink-3);
  }
  .pal-list {
    list-style: none;
    margin: 0;
    padding: 6px;
    max-height: min(380px, 50vh);
    overflow-y: auto;
  }
  .pal-list :global(li) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: var(--fs-small);
    color: var(--ink-2);
    cursor: pointer;
  }
  .pal-list :global(li[aria-selected='true']) {
    color: var(--ink);
    background: rgb(var(--wash-rgb) / 0.07);
  }
  .pal-list :global(.k) {
    flex: none;
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  .pal-list :global(mark) {
    color: inherit;
    background: none;
    text-decoration: underline;
    text-decoration-color: var(--t2);
    text-underline-offset: 3px;
  }
  .pal-list :global(.empty) {
    cursor: default;
    color: var(--ink-3);
  }
  .pal-hint {
    padding: 10px 16px 12px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  @media (pointer: coarse) {
    .pal-hint {
      display: none;
    }
  }
</style>

<script>
  type Item = { t: string; k: string; href: string; ext?: boolean; dl?: boolean };
  const dlg = document.querySelector<HTMLDialogElement>('[data-pal]');
  const raw = document.querySelector('[data-pal-items]')?.textContent;
  if (dlg && raw) {
    const items: Item[] = JSON.parse(raw);
    const q = dlg.querySelector<HTMLInputElement>('[data-pal-q]')!;
    const list = dlg.querySelector<HTMLUListElement>('[data-pal-list]')!;
    let shown: Item[] = [];
    let sel = 0;

    // subsequence match: every typed character in order; earlier, tighter and
    // word-start matches rank higher
    const match = (text: string, query: string) => {
      const t = text.toLowerCase();
      let score = 0,
        last = -1;
      const at: number[] = [];
      for (const ch of query.toLowerCase()) {
        if (ch === ' ') continue;
        const i = t.indexOf(ch, last + 1);
        if (i < 0) return null;
        score += i === last + 1 ? 3 : 1;
        if (i === 0 || t[i - 1] === ' ') score += 2;
        at.push(i);
        last = i;
      }
      return { score: score - at[0] * 0.05 - t.length * 0.01, at };
    };
    const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
    const mark = (text: string, at: number[]) => [...text].map((c, i) => (at.includes(i) ? `<mark>${esc(c)}</mark>` : esc(c))).join('');

    const render = () => {
      const query = q.value.trim();
      const ranked = query
        ? items
            .map((it) => ({ it, m: match(it.t, query) }))
            .filter((r) => r.m)
            .sort((a, b) => b.m!.score - a.m!.score)
            .slice(0, 8)
        : items.slice(0, 8).map((it) => ({ it, m: { score: 0, at: [] as number[] } }));
      shown = ranked.map((r) => r.it);
      sel = Math.min(sel, Math.max(0, shown.length - 1));
      list.innerHTML = shown.length
        ? ranked
            .map(
              (r, i) =>
                `<li role="option" id="pal-${i}" aria-selected="${i === sel}" data-i="${i}"><span>${mark(r.it.t, r.m!.at)}</span><span class="k">${r.it.k}</span></li>`,
            )
            .join('')
        : `<li class="empty" role="option" aria-disabled="true">Nothing matches “${esc(query)}”</li>`;
      q.setAttribute('aria-activedescendant', shown.length ? `pal-${sel}` : '');
    };
    const go = (it: Item | undefined) => {
      if (!it) return;
      dlg.close();
      if (it.dl) {
        const a = document.createElement('a');
        a.href = it.href;
        a.download = '';
        a.click();
      } else if (it.ext) window.open(it.href, '_blank', 'noopener');
      else if (it.href.startsWith('#')) {
        // same-page sections go through the page's own smooth scroll
        const a = document.createElement('a');
        a.href = it.href;
        document.body.append(a);
        a.click();
        a.remove();
      } else location.href = it.href;
    };
    const open = (seed = '') => {
      if (dlg.open) return;
      q.value = seed;
      sel = 0;
      render();
      dlg.showModal();
      q.focus();
      q.setSelectionRange(q.value.length, q.value.length);
    };

    q.addEventListener('input', () => {
      sel = 0;
      render();
    });
    q.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        sel = (sel + (e.key === 'ArrowDown' ? 1 : -1) + shown.length) % Math.max(1, shown.length);
        render();
        list.querySelector('[aria-selected="true"]')?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter') {
        e.preventDefault();
        go(shown[sel]);
      }
    });
    list.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('li[data-i]');
      if (li) go(shown[Number(li.dataset.i)]);
    });
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });

    document.querySelectorAll('[data-pal-open]').forEach((b) => b.addEventListener('click', () => open()));

    // open on ⌘K / Ctrl K, or on any printable key typed outside a text field
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        open();
        return;
      }
      if (dlg.open || e.metaKey || e.ctrlKey || e.altKey || e.key.length !== 1 || e.key === ' ') return;
      const t = e.target as HTMLElement;
      if (t.closest('input, textarea, select, [contenteditable=""], [contenteditable="true"], dialog')) return;
      e.preventDefault();
      open(e.key);
    });
  }
</script>
