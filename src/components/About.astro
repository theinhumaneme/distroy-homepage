---
import ChapterHead from './ChapterHead.astro';
import TypeChallenge from './TypeChallenge.astro';
import { about, offClock } from '../data/content';
const stats = offClock.stats;
---

<section id="about" class="chapter" data-stage="about" data-field="8" data-field-level="0.85" aria-labelledby="about-title">
  <div class="wrap">
    <ChapterHead id="about" color="var(--t4)" minor>
      <span slot="title" id="about-title">{about.title}</span>
    </ChapterHead>

    <div class="story">
      <p class="lead" data-reveal>{about.lead}</p>
      <div class="story-body" data-reveal data-reveal-delay="0.08">
        {about.story.map((t) => <p>{t}</p>)}
        <p>
          {about.blogLine.text} <a href={about.blogLine.url}>{about.blogLine.link}</a>.
        </p>
      </div>
    </div>

    <div class="off" data-reveal>
      <div class="off-text">
        <h3 class="off-title">{offClock.title}</h3>
        <p>{offClock.text}</p>
        {
          stats.length > 0 && (
            <dl class="off-stats">
              {stats.map((s) => (
                <div>
                  <dt>{s.k}</dt>
                  <dd>{s.v}</dd>
                  <dd class="note">{s.note}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
      <TypeChallenge />
    </div>

    <div class="ab-grid">
      <section class="col" data-reveal>
        <h3 class="mono">Education</h3>
        <ul class="edu">
          {
            about.education.map((e) => (
              <li>
                <p class="e-n">{e.name}</p>
                <p class="e-w">{e.what}</p>
                <p class="mono faint e-d">{e.when}</p>
              </li>
            ))
          }
        </ul>
        <h3 class="mono">Current coursework</h3>
        <ul class="course">
          {
            about.coursework.map((c) => (
              <li>
                <span class="mono code">{c.code}</span>
                <span>{c.title}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="col" data-reveal data-reveal-delay="0.06">
        <h3 class="mono">Awards and certifications</h3>
        <ul class="awards">
          {
            about.awards.map((a) => (
              <li>
                <span class="a-n">{a.name}</span>
                <span class="a-b">
                  {a.by} · {a.when}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="col" data-reveal data-reveal-delay="0.12">
        <h3 class="mono">Areas of interest</h3>
        <ul class="plain">{about.interests.map((x) => <li>{x}</li>)}</ul>
        <h3 class="mono">Publication</h3>
        <a class="pub" href={about.publication.url} target="_blank" rel="noopener">
          <span class="p-t">{about.publication.title} <span aria-hidden="true">↗</span></span>
          <span class="mono faint">{about.publication.venue}</span>
          <span class="p-n">{about.publication.note}</span>
        </a>
        <h3 class="mono">Leadership</h3>
        <ul class="plain">{about.leadership.map((x) => <li>{x}</li>)}</ul>
        <h3 class="mono">Writing</h3>
        <ul class="plain writing">
          {
            about.writing.map((w) => (
              <li>
                <a class="link" href={w.url} target="_blank" rel="noopener">
                  {w.title} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</section>

<style>
  /* a one-line lead in the display voice, then the story at reading size */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: start;
    margin-bottom: clamp(56px, 9vh, 96px);
  }
  .lead {
    max-width: 16em;
    font-size: var(--fs-lead);
    font-weight: var(--fw-medium);
    line-height: 1.3;
    letter-spacing: var(--tr-snug);
    text-wrap: balance;
  }
  .story-body {
    display: grid;
    gap: 1em;
    max-width: 34em;
    font-size: var(--fs-lede);
    line-height: 1.65;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .story-body a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-3);
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s;
  }
  .story-body a:hover {
    text-decoration-color: var(--t2);
  }
  @media (max-width: 900px) {
    .story {
      grid-template-columns: 1fr;
    }
  }

  /* cubing and typing: a short note beside a typing line to try */
  .off {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: start;
    margin-bottom: clamp(56px, 9vh, 96px);
    padding-top: clamp(28px, 4vh, 40px);
    border-top: 1px solid var(--line);
  }
  .off-text {
    display: grid;
    gap: 12px;
    max-width: 30em;
    color: var(--ink-2);
    line-height: 1.65;
  }
  .off-title {
    font-size: var(--fs-title);
    font-weight: var(--fw-head);
    letter-spacing: var(--tr-snug);
    color: var(--ink);
  }
  .off-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin: 6px 0 0;
  }
  .off-stats dt {
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  .off-stats dd {
    margin: 2px 0 0;
    font-size: var(--fs-title-s);
    font-weight: var(--fw-medium);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .off-stats dd.note {
    margin-top: 2px;
    font-size: var(--fs-xs);
    font-weight: var(--fw-body);
    color: var(--ink-3);
  }
  @media (max-width: 900px) {
    .off {
      grid-template-columns: 1fr;
    }
  }

  .ab-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3.5vw, 56px);
  }
  .col {
    display: grid;
    align-content: start;
    gap: 14px;
  }
  .col h3 {
    margin: 18px 0 0;
    font-size: var(--fs-micro);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tr-mono);
    color: var(--ink-3);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .col h3:first-child {
    margin-top: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .edu {
    display: grid;
    gap: 18px;
  }
  .e-n {
    font-weight: var(--fw-head);
  }
  .e-w {
    color: var(--ink-2);
    font-size: var(--fs-body-s);
  }
  .e-d {
    font-size: var(--fs-micro);
    margin-top: 4px;
  }
  .course {
    display: grid;
    gap: 8px;
    font-size: var(--fs-body-s);
    color: var(--ink-2);
  }
  .course li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    align-items: baseline;
  }
  .code {
    font-size: var(--fs-micro);
    color: var(--ink-3);
    width: 52px;
  }
  .awards {
    display: grid;
  }
  .awards li {
    display: grid;
    gap: 2px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }
  .awards li:first-child {
    padding-top: 0;
  }
  .a-n {
    font-size: var(--fs-body-s);
    line-height: 1.35;
  }
  .a-b {
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  .plain {
    display: grid;
    gap: 8px;
    font-size: var(--fs-body-s);
    color: var(--ink-2);
  }
  .pub {
    display: grid;
    gap: 6px;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgb(var(--wash-rgb) / 0.02);
    transition: border-color 0.3s;
  }
  .pub:hover {
    border-color: var(--line-3);
  }
  .p-t {
    font-size: var(--fs-body-s);
    line-height: 1.45;
  }
  .pub .mono {
    font-size: var(--fs-micro);
  }
  .p-n {
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  .writing .link {
    font-family: var(--f-sans);
    font-size: var(--fs-small);
  }

  @media (max-width: 1000px) {
    .ab-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 680px) {
    .ab-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
