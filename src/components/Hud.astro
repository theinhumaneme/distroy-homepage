---
import { chapters } from '../data/content';
interface Props {
  // pages other than the home page point the section links back at it
  base?: string;
  where?: string;
}
const { base = '', where = `01 / ${String(chapters.length).padStart(2, '0')} · ${chapters[0].label}` } = Astro.props;
---

<header class="hud">
  <a class="mark mono" href={`${base}#top`} aria-label="Back to top">
    <span class="mk" aria-hidden="true"><i></i><i></i><i></i></span>
    <span>kalyan<span class="faint">.</span>mudumby</span>
  </a>

  <nav class="stages" aria-label="Sections">
    {
      chapters.map((c) => (
        <a href={`${base}#${c.id}`} data-stage-link>
          {c.label === 'Explore my work' ? 'Explore' : c.label}
        </a>
      ))
    }
  </nav>

  {!base && <details class="mobile-nav mono">
    <summary>Menu <span aria-hidden="true">+</span></summary>
    <nav aria-label="Mobile sections">
      {chapters.map((c) => <a href={`#${c.id}`}>{c.label}</a>)}
    </nav>
  </details>}

  <div class="where mono" aria-hidden="true">
    <span class="num" data-where>{where}</span>
    <span class="track"><span class="fill" data-progress></span></span>
  </div>
</header>

<style>
  .hud {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--hud-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding-inline: var(--gutter);
    transition:
      background 0.4s,
      border-color 0.4s;
    border-bottom: 1px solid transparent;
  }
  .hud:global(.scrolled) {
    background: rgba(6, 6, 9, 0.62);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    border-color: var(--line);
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    justify-self: start;
  }
  .mk {
    display: inline-flex;
    gap: 2px;
    height: 14px;
  }
  .mk i {
    display: block;
    width: 4px;
    border-radius: 2px;
    background: var(--t1);
  }
  .mk i:first-child {
    width: 8px;
  }
  .mk i:nth-child(2) {
    background: var(--t2);
  }
  .mk i:nth-child(3) {
    background: var(--t3);
  }
  .stages {
    display: flex;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--line);
    font-size: 0.8rem;
  }
  .stages a {
    padding: 6px 13px;
    border-radius: 999px;
    color: var(--ink-3);
    transition:
      color 0.3s,
      background 0.3s;
    white-space: nowrap;
  }
  .stages a:hover {
    color: var(--ink);
  }
  .stages a:global(.on) {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.08);
  }
  .where {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.7rem;
    color: var(--ink-3);
  }
  .where .num {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 52vw;
  }
  .track {
    width: 84px;
    height: 3px;
    border-radius: 3px;
    background: var(--line-2);
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--t1), var(--t2), var(--t3));
    transform-origin: left;
    transform: scaleX(0);
  }

  @media (max-width: 1100px) {
    .stages {
      display: none;
    }
    .hud {
      grid-template-columns: auto 1fr;
    }
  }
  @media (max-width: 420px) {
    .track {
      width: 40px;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
  });
</script>
