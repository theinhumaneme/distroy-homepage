---
import { existsSync } from 'node:fs';
import { chapters, person } from '../data/content';
interface Props {
  // pages other than the home page point the section links back at it
  base?: string;
}
const { base = '' } = Astro.props;
// the blog lives on its own pages; the bar links there rather than to a section
const onBlog = /^\/(blog|post)\//.test(Astro.url.pathname);
const hasResume = existsSync(new URL('../../public/kalyan-mudumby-resume.pdf', import.meta.url));
---

<header class="hud">
  <a class="mark mono" href={`${base}#top`} aria-label="Back to top">
    <span class="mk" aria-hidden="true"><i></i><i></i><i></i></span>
    <span>kalyan<span class="faint">.</span>mudumby</span>
  </a>

  <nav class="stages" aria-label="Sections">
    {chapters.map((c) => <a href={`${base}#${c.id}`} data-stage-link>{c.label}</a>)}
  </nav>

  <div class="acts">
    <a class="act blog" href="/blog/" aria-current={onBlog ? 'page' : undefined}>Blog</a>
    <a class="act mail" href={`mailto:${person.email}`}>Email</a>
    {hasResume && <a class="act resume" href={person.resume} download>Resume <span aria-hidden="true">↓</span></a>}
    <details class="mobile-nav mono">
      <summary>Menu <span aria-hidden="true">+</span></summary>
      <div class="sheet">
        <nav aria-label="Sections">
          {chapters.map((c) => <a href={`${base}#${c.id}`} data-stage-link>{c.label}</a>)}
        </nav>
        <div class="reach">
          <a href="/blog/" aria-current={onBlog ? 'page' : undefined}>Blog <span aria-hidden="true">→</span></a>
          <a href={`mailto:${person.email}`}>{person.email}</a>
          <a href={person.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  /* One bar on every page: the tokens are pinned here so the blog's quieter
     palette doesn't restyle it */
  .hud {
    --ink-2: #bdbbb7;
    --ink-3: #92918e;
    --line: rgba(238, 237, 232, 0.09);
    --line-2: rgba(238, 237, 232, 0.16);
    --fs-xs: 0.8125rem;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--hud-h);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
    padding-inline: var(--gutter);
    background: rgba(6, 6, 9, 0.82);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--line);
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    justify-self: start;
  }
  .mk {
    display: inline-flex;
    gap: 2px;
    height: 14px;
  }
  .mk i {
    display: block;
    width: 4px;
    border-radius: 2px;
    background: var(--t1);
  }
  .mk i:first-child {
    width: 8px;
  }
  .mk i:nth-child(2) {
    background: var(--t2);
  }
  .mk i:nth-child(3) {
    background: var(--t3);
  }
  .stages {
    justify-self: center;
    display: flex;
    gap: 2px;
    font-size: 0.8125rem;
  }
  .stages a {
    padding: 7px 10px;
    border-radius: 999px;
    color: var(--ink-3);
    transition:
      color 0.3s,
      background 0.3s;
    white-space: nowrap;
  }
  .stages a:hover {
    color: var(--ink);
  }
  .stages a:global(.on) {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.08);
  }

  /* The two things a recruiter came for, reachable from every scroll position */
  .acts {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .act {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    white-space: nowrap;
    color: var(--ink-2);
    border: 1px solid var(--line-2);
    transition:
      color 0.2s,
      background 0.2s,
      border-color 0.2s;
  }
  .act:hover {
    color: var(--ink);
    border-color: var(--line-3);
    background: rgba(255, 255, 255, 0.05);
  }
  .act[aria-current='page'] {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.08);
  }
  .act.resume {
    color: var(--bg);
    background: var(--ink);
    border-color: var(--ink);
  }
  .act.resume:hover {
    background: #fff;
  }

  .mobile-nav {
    display: none;
    font-size: var(--fs-xs);
  }
  .mobile-nav summary {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    cursor: pointer;
    list-style: none;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--ink-2);
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav summary span {
    margin-left: 10px;
    color: var(--t2);
    transition: transform 0.25s var(--ease-out);
  }
  .mobile-nav[open] summary span {
    display: inline-block;
    transform: rotate(45deg);
  }
  .sheet {
    position: absolute;
    right: var(--gutter);
    top: calc(var(--hud-h) - 4px);
    width: min(300px, calc(100vw - 2 * var(--gutter)));
    padding: 8px;
    background: #101017;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    box-shadow: 0 20px 60px -10px rgba(0, 0, 0, 0.7);
  }
  .sheet a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 14px;
    color: var(--ink-2);
    border-radius: 6px;
    overflow-wrap: anywhere;
  }
  .sheet a:hover {
    color: var(--ink);
    background: var(--bg-3);
  }
  .sheet nav a:global(.on) {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.06);
  }
  .sheet nav a:global(.on)::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--t2);
  }
  .reach {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--line-2);
  }
  .reach a {
    color: var(--ink);
  }

  @media (max-width: 1100px) {
    .stages {
      display: none;
    }
    .hud {
      grid-template-columns: auto 1fr;
    }
    .mobile-nav {
      display: block;
    }
  }
  @media (max-width: 480px) {
    .hud {
      gap: 10px;
    }
    .acts {
      gap: 6px;
    }
  }
  @media (max-width: 560px) {
    .act.mail,
    .act.blog {
      display: none;
    }
    .act,
    .mobile-nav summary {
      padding-inline: 11px;
    }
    .mobile-nav summary span {
      margin-left: 8px;
    }
  }
  @media (max-width: 360px) {
    .mark > span:last-child {
      display: none;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
  });
</script>
