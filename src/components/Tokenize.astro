---
import ChapterHead from './ChapterHead.astro';
import Cite from './Cite.astro';
import { origin } from '../data/content';
import { tokenize } from '../lib/build';

const toks = tokenize(origin.text);
const chars = origin.text.length;
---

<section id="tokenize" class="chapter" data-stage="tokenize" data-field="1" data-field-level="0.75" aria-labelledby="tok-title">
  <div class="wrap">
    <ChapterHead n="01" stage="tokenize" color="var(--t1)">
      <span slot="title" id="tok-title">It started with <span class="serif">a library.</span></span>
      The first system I shipped went live in 2020, two years before my first job, and served students until 2025. Here is
      that story, split the way a model reads it.
    </ChapterHead>

    <div class="tok-grid">
      <figure class="panel tok-panel" data-reveal>
        <div class="panel-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>origin.txt · o200k_base</span>
          <div class="modes" role="group" aria-label="Display mode">
            <button type="button" data-mode="text">text</button>
            <button type="button" data-mode="tokens" class="on">tokens</button>
            <button type="button" data-mode="ids">ids</button>
          </div>
        </div>
        <p class="sr-only">{origin.text}</p>
        <div class="tok-body mode-tokens" aria-hidden="true" data-tok-body>
          {
            toks.map((t, i) => (
              <span class={`tk c${(i % 5) + 1}`}>
                <span class="tx">{t.t}</span>
                <span class="id">{t.id}</span>
              </span>
            ))
          }
        </div>
        <figcaption class="tok-foot mono">
          <span><b data-lit-count>0</b> / {toks.length} tokens</span>
          <span>{chars} characters</span>
          <span>{(chars / toks.length).toFixed(2)} chars / token</span>
        </figcaption>
      </figure>

      <div class="origin-side">
        <dl class="stats">
          {
            origin.stats.map((s, i) => (
              <div class="stat" data-reveal data-reveal-delay={String(i * 0.08)}>
                <dt class="mono">
                  {s.label}
                  <Cite src={s.src} />
                </dt>
                <dd data-count={s.value}>{s.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="span mono" data-reveal>{origin.span}</p>
        <p class="aside" data-reveal>{origin.aside}<Cite src={origin.asideSrc} /></p>
      </div>
    </div>
  </div>
</section>

<style>
  .tok-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }
  .tok-panel {
    margin: 0;
  }
  .modes {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.04);
  }
  .modes button {
    padding: 4px 9px;
    border-radius: 5px;
    color: var(--ink-3);
    transition: color 0.2s, background 0.2s;
  }
  .modes button:hover {
    color: var(--ink);
  }
  .modes button.on {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.09);
  }

  .tok-body {
    padding: clamp(20px, 3vw, 36px);
    font-size: clamp(1.15rem, 1.7vw, 1.55rem);
    line-height: 1.75;
    letter-spacing: -0.012em;
    color: var(--ink-3);
  }
  .tk {
    --c: var(--t1);
    border-radius: 4px;
    padding: 0.06em 0;
    transition:
      background 0.35s var(--ease-out),
      color 0.35s,
      box-shadow 0.35s;
    white-space: pre-wrap;
  }
  .tk .id {
    display: none;
  }
  .mode-tokens .tk.lit {
    color: var(--ink);
    background: color-mix(in oklab, var(--c) 20%, transparent);
    box-shadow: inset 0 -2px 0 color-mix(in oklab, var(--c) 75%, transparent);
  }
  .mode-text .tk {
    color: var(--ink);
  }
  .mode-ids {
    font-family: var(--f-mono);
    font-size: clamp(0.82rem, 1.05vw, 0.95rem);
    line-height: 2.1;
  }
  .mode-ids .tk {
    color: var(--ink);
    background: color-mix(in oklab, var(--c) 16%, transparent);
    padding: 0.2em 0.4em;
    margin: 0 2px;
  }
  .mode-ids .tk .tx {
    display: none;
  }
  .mode-ids .tk .id {
    display: inline;
  }
  .c1 {
    --c: var(--t1);
  }
  .c2 {
    --c: var(--t2);
  }
  .c3 {
    --c: var(--t3);
  }
  .c4 {
    --c: var(--t4);
  }
  .c5 {
    --c: var(--t5);
  }

  .tok-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    padding: 14px 18px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-micro);
    color: var(--ink-3);
  }
  .tok-foot b {
    color: var(--t2);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .stat {
    padding: clamp(18px, 2.4vw, 28px);
    background: var(--bg-1);
  }
  .stat dt {
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .stat dd {
    margin: 10px 0 0;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
    font-weight: 560;
    font-variant-numeric: tabular-nums;
  }
  .span {
    margin-top: 18px;
    font-size: var(--fs-micro);
    color: var(--ink-3);
    letter-spacing: 0.03em;
  }
  .aside {
    margin-top: 22px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 0.98rem;
  }

  @media (max-width: 960px) {
    .tok-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const body = document.querySelector<HTMLElement>('[data-tok-body]');
  const counter = document.querySelector<HTMLElement>('[data-lit-count]');

  if (body) {
    const toks = [...body.querySelectorAll<HTMLElement>('.tk')];
    let lit = 0;
    const setLit = (n: number) => {
      if (n === lit) return;
      toks.forEach((t, i) => t.classList.toggle('lit', i < n));
      lit = n;
      if (counter) counter.textContent = String(n);
    };

    if (reduce) setLit(toks.length);
    else
      ScrollTrigger.create({
        trigger: body,
        start: 'top 80%',
        end: 'bottom 45%',
        scrub: true,
        onUpdate: (self) => setLit(Math.round(self.progress * toks.length)),
      });

    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
      b.addEventListener('click', () => {
        document.querySelectorAll('[data-mode]').forEach((x) => x.classList.toggle('on', x === b));
        body.className = `tok-body mode-${b.dataset.mode}`;
        if (b.dataset.mode !== 'tokens') setLit(toks.length);
        ScrollTrigger.refresh();
      }),
    );
  }

  // count-up for any [data-count] value like "4,000+" or "99%+"
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
    const raw = el.dataset.count ?? '';
    const m = raw.match(/[\d,.]+/);
    if (!m || reduce) return;
    const target = parseFloat(m[0].replace(/,/g, ''));
    const [pre, post] = raw.split(m[0]);
    const fmt = new Intl.NumberFormat('en-US');
    const o = { v: 0 };
    el.textContent = `${pre}0${post}`;
    gsap.to(o, {
      v: target,
      duration: 1.8,
      ease: 'expo.out',
      scrollTrigger: { trigger: el, start: 'top 90%', once: true },
      onUpdate: () => (el.textContent = `${pre}${fmt.format(Math.round(o.v))}${post}`),
    });
  });
</script>
