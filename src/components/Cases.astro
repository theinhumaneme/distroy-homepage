---
import ChapterHead from './ChapterHead.astro';
import Cite from './Cite.astro';
import RagViz from './viz/RagViz.astro';
import GraphViz from './viz/GraphViz.astro';
import DeviceViz from './viz/DeviceViz.astro';
import FleetViz from './viz/FleetViz.astro';
import CheckpointViz from './viz/CheckpointViz.astro';
import RouteViz from './viz/RouteViz.astro';
import BarsViz from './viz/BarsViz.astro';
import { cases, casesCopy } from '../data/content';

const VIZ = { rag: RagViz, graph: GraphViz, device: DeviceViz, fleet: FleetViz, checkpoint: CheckpointViz, route: RouteViz, bars: BarsViz };
let n = 0;
const numbered = cases.map((c) => ({ ...c, n: c.compact ? '' : String(++n).padStart(2, '0') }));
---

<section id="work" class="chapter cases" data-stage="work" data-field="0" data-field-level="0.28" aria-labelledby="work-title">
  <div class="wrap">
    <ChapterHead id="work" color="var(--t1)">
      <span slot="title" id="work-title">{casesCopy.title}</span>
      AI applications, backend systems, and tools I’ve built to solve problems in everyday work. Explore what they do and the decisions behind them.
    </ChapterHead>

    <nav class="project-index" aria-label="Selected projects" data-reveal>
      {numbered.filter((c) => !c.compact).map((c) => (
        <a href={`#${c.anchor}`}><span class="mono">{c.n}</span>{c.title}<span class="index-arrow" aria-hidden="true">↗</span></a>
      ))}
    </nav>
    {
      numbered.map((c, i) => {
        const Viz = c.viz ? VIZ[c.viz] : null;
        const eras = c.body.filter((b) => b.label);
        const plain = c.body.filter((b) => !b.label);
        if (c.compact)
          return (
            <article id={c.anchor} class="compact panel" aria-labelledby={`${c.anchor}-t`} data-reveal>
              <div class="cp-left">
                <p class="meta mono">
                  <span>{c.org}</span>
                  <span class="faint">{c.period}</span>
                </p>
                <h3 id={`${c.anchor}-t`} class="cp-title">
                  {c.headline}
                </h3>
                {plain.map((b) => (
                  <p class="body">{b.text}</p>
                ))}
              </div>
              <div class="cp-right">
                <span class="merged mono">⑂ merged</span>
                <span class="mono">langchain-ai/langchain</span>
                {c.links.map((l) => (
                  <a class="link" href={l.url} target="_blank" rel="noopener">
                    {l.label} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </article>
          );
        return (
          <article id={c.anchor} class:list={['case', { flip: i % 2 === 0 && i > 0 }]} aria-labelledby={`${c.anchor}-t`}>
            <p class="meta mono" data-reveal>
              <span class="num">{c.n}</span>
              <span>{c.org}</span>
              {c.period && <span class="faint">{c.period}</span>}
            </p>
            <div class="case-grid">
              <div class="case-text">
                <h3 id={`${c.anchor}-t`} class="case-title" data-split>
                  {c.title}
                </h3>
                <p class="headline serif" data-reveal>
                  {c.headline}
                </p>
                {plain.map((b) => (
                  <p class="body" data-reveal>
                    {b.text}
                  </p>
                ))}
                {eras.length > 0 && (
                  <div class="eras" data-reveal>
                    {eras.map((b) => (
                      <div class="era">
                        <p class="era-l mono">{b.label}</p>
                        <p>{b.text}</p>
                      </div>
                    ))}
                  </div>
                )}
                {c.badges && (
                  <ul class="badges" data-reveal>
                    {c.badges.map((b) => (
                      <li class="mono">
                        <span aria-hidden="true">◆</span> {b}
                      </li>
                    ))}
                  </ul>
                )}
                {c.privacy && (
                  <p class="privacy mono" data-reveal>
                    <span aria-hidden="true">◎</span> {c.privacy}
                  </p>
                )}
                {c.points.length > 0 && (
                  <>
                    {c.pointsTitle && (
                      <p class="pt-title mono" data-reveal>
                        {c.pointsTitle}
                      </p>
                    )}
                    <ul class="points">
                      {c.points.map((p, k) => (
                        <li data-reveal data-reveal-delay={String(k * 0.06)}>
                          <span class="pt-n mono">{String(k + 1).padStart(2, '0')}</span>
                          <span>
                            {p.label && <b class="pt-l">{p.label}. </b>}
                            {p.text}
                            <Cite src={p.src} />
                          </span>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                {c.note && (
                  <aside class="note" data-reveal>
                    <p class="mono">{c.note.label}</p>
                    <p>{c.note.text}</p>
                  </aside>
                )}
                <div class="chips" data-reveal>
                  {c.stack.map((s) => (
                    <span class="chip">{s}</span>
                  ))}
                </div>
                {c.links.length > 0 && (
                  <div class="links" data-reveal>
                    {c.links.map((l) => (
                      <a class="link" href={l.url} target="_blank" rel="noopener">
                        {l.label} <span aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
              {Viz && (
                <figure class:list={['panel', 'case-viz', { bare: c.viz === 'checkpoint' || c.viz === 'route' || c.viz === 'bars' }]} data-reveal>
                  <Viz />
                </figure>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .case {
    padding-block: clamp(40px, 8vh, 96px);
    scroll-margin-top: calc(var(--hud-h) + 12px);
  }
  .case + .case,
  .compact + .case {
    border-top: 1px dashed var(--line-2);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    align-items: center;
    margin-bottom: clamp(20px, 3.5vh, 36px);
    font-size: var(--fs-micro);
    color: var(--ink-2);
  }
  .meta .num {
    color: var(--bg);
    background: var(--ink);
    padding: 3px 8px;
    border-radius: 5px;
    font-weight: var(--fw-medium);
  }

  .case-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: clamp(28px, 4.5vw, 80px);
    align-items: start;
  }
  .flip .case-text {
    order: 2;
  }
  .case-title {
    font-size: var(--fs-h3);
    letter-spacing: var(--tr-head);
    line-height: 1;
    font-weight: var(--fw-head);
  }
  .headline {
    margin-top: 14px;
    font-size: var(--fs-quote);
    line-height: 1.12;
    color: var(--ink);
    text-wrap: balance;
  }
  .body {
    margin-top: 18px;
    color: var(--ink-2);
    max-width: 60ch;
    text-wrap: pretty;
  }
  .eras {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 20px;
  }
  .era {
    padding: 16px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--line);
    font-size: var(--fs-body-s);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .era-l {
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mono);
    color: var(--t5);
    margin-bottom: 8px;
  }
  .era + .era .era-l {
    color: var(--t2);
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
  }
  .badges li {
    font-size: var(--fs-micro);
    padding: 7px 12px;
    border-radius: 8px;
    color: var(--t3);
    background: color-mix(in oklab, var(--t3) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--t3) 35%, transparent);
  }
  .privacy {
    margin-top: 18px;
    font-size: var(--fs-xs);
    color: var(--t2);
    display: flex;
    gap: 10px;
    line-height: 1.5;
  }
  .pt-title {
    margin-top: 28px;
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mono);
    color: var(--ink-3);
  }
  .points {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: grid;
  }
  .pt-title + .points {
    margin-top: 10px;
  }
  .points li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 8px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: var(--fs-body-s);
    line-height: 1.55;
  }
  .pt-n {
    font-size: var(--fs-micro);
    color: var(--ink-3);
    padding-top: 4px;
  }
  .pt-l {
    font-weight: var(--fw-head);
    color: var(--ink);
  }
  .note {
    margin-top: 22px;
    padding: 14px 16px;
    border: 1px solid color-mix(in oklab, var(--t3) 28%, transparent);
    background: color-mix(in oklab, var(--t3) 5%, transparent);
    border-radius: 10px;
    font-size: var(--fs-body-s);
    color: var(--ink-2);
  }
  .note .mono {
    font-size: var(--fs-micro);
    letter-spacing: var(--tr-mono);
    color: var(--t3);
    margin-bottom: 6px;
  }
  .chips {
    margin-top: 22px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 22px;
  }
  .case-viz {
    margin: 0;
    padding: 52px 8px 14px;
    position: sticky;
    top: calc(var(--hud-h) + 24px);
  }
  .case-viz.bare {
    padding-top: 0;
  }

  .compact {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 24px 48px;
    align-items: center;
    margin-block: clamp(8px, 2vh, 24px) clamp(40px, 6vh, 72px);
    padding: clamp(22px, 3vw, 36px);
    scroll-margin-top: calc(var(--hud-h) + 12px);
  }
  .compact .meta {
    margin-bottom: 12px;
  }
  .cp-title {
    font-size: var(--fs-lead);
    letter-spacing: var(--tr-head);
    line-height: 1.15;
    font-weight: var(--fw-head);
  }
  .compact .body {
    margin-top: 10px;
  }
  .cp-right {
    display: grid;
    gap: 10px;
    justify-items: start;
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }
  .merged {
    font-size: var(--fs-micro);
    padding: 5px 10px;
    border-radius: 999px;
    background: #8957e5;
    color: #fff;
  }

  @media (max-width: 960px) {
    .case-grid,
    .compact {
      grid-template-columns: 1fr;
    }
    .flip .case-text {
      order: 0;
    }
    .case-viz {
      position: relative;
      top: 0;
    }
  }
  @media (max-width: 560px) {
    .eras {
      grid-template-columns: 1fr;
    }
  }
</style>
