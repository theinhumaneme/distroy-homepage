---
import VizFrame from './VizFrame.astro';
import Node from './Node.astro';
const json = ['{', '  "vendor": "…",', '  "date": "…",', '  "line_items": […],', '  "total": …', '}'];
---

<VizFrame name="device" status="drop a file" caption="illustrative · output shape only · syncing to Sheets is a separate, optional step">
  <button slot="controls" type="button" class="viz-btn sync" data-sync>Send to Sheets</button>
  <div class="viz-canvas">
    <svg viewBox="0 0 560 296" role="img" aria-label="Diagram: a file is dropped inside a boundary labelled your machine. A local vision model reads it and structured data comes out. Sending results to Google Sheets over MCP is a separate, optional action.">
      <rect class="zone" x="12" y="12" width="408" height="276" rx="16" />
      <text x="28" y="34" class="zl">your machine</text>

      <rect class="drop" x="32" y="52" width="100" height="134" rx="12" data-drop />
      <g data-doc>
        <rect class="doc" x="52" y="68" width="60" height="80" rx="6" />
        <rect class="ln strong" x="61" y="80" width="30" height="5" rx="2.5" />
        <rect class="ln" x="61" y="93" width="42" height="3" rx="1.5" />
        <rect class="ln" x="61" y="101" width="36" height="3" rx="1.5" />
        <rect class="ln" x="61" y="109" width="42" height="3" rx="1.5" />
        <rect class="ln" x="61" y="128" width="18" height="3" rx="1.5" />
        <rect class="amt" x="86" y="126" width="17" height="7" rx="2" />
        <rect class="scan" x="52" y="68" width="60" height="2" data-scan style="opacity:0" />
      </g>
      <text x="82" y="204" text-anchor="middle" class="sub">drop a file</text>

      <path class="wire" data-p="dm" d="M132 82 H160" />
      <Node id="model" x={160} y={56} w={240} label="local vision model" sub="served on-device" kind="ai" />
      <path class="wire" data-p="mj" d="M280 108 V136" />

      <rect class="box" data-n="json" x="160" y="136" width="240" height="134" rx="10" />
      <path class="kind-bar json-bar" d="M174 266 H386" />
      {json.map((l, i) => <text x="178" y={162 + i * 17} class="code" data-json-line>{l}</text>)}

      <path class="wire dash" data-p="mcp" d="M400 203 H444" data-mcp-wire />
      <g data-sheets class="sheets">
        <Node id="sheets" x={444} y={177} w={104} label="Sheets" sub="MCP · opt-in" kind="cache" />
      </g>

      <circle class="pkt" r="4.5" cx="0" cy="0" data-pkt style="opacity:0" />
    </svg>
  </div>
</VizFrame>

<style>
  .zone {
    --zc: var(--t2);
  }
  .zl {
    fill: var(--t2);
  }
  .drop {
    fill: none;
    stroke: var(--viz-edge);
    stroke-dasharray: 4 5;
  }
  .doc {
    fill: var(--viz-node);
    stroke: var(--viz-edge);
  }
  .ln {
    fill: rgb(var(--ink-rgb) / 0.18);
  }
  .ln.strong {
    fill: rgb(var(--ink-rgb) / 0.4);
  }
  .amt {
    fill: var(--t3);
    opacity: 0.7;
  }
  .scan {
    fill: var(--t1);
  }
  .code {
    fill: var(--ink-2);
    opacity: 0.35;
  }
  .json-bar {
    stroke: var(--t2);
  }
  .sheets {
    opacity: 0.5;
  }
  [data-mcp-wire] {
    opacity: 0.5;
  }
  .sync {
    color: var(--t3);
    border-color: color-mix(in oklab, var(--t3) 40%, transparent);
    background: color-mix(in oklab, var(--t3) 8%, transparent);
  }
  .sync:hover {
    color: var(--t3);
    border-color: color-mix(in oklab, var(--t3) 60%, transparent);
    background: color-mix(in oklab, var(--t3) 14%, transparent);
  }
  .sync[disabled] {
    opacity: 0.5;
    cursor: default;
  }
</style>

<script>
  import { gsap, C, col, paint, playWhenVisible, setBusy, glow, travel, say } from '../../scripts/viz';

  document.querySelectorAll<HTMLElement>('[data-viz="device"]').forEach((root) => {
    const $ = (s: string) => root.querySelector(s);
    const p = (k: string) => $(`[data-p="${k}"]`);
    const n = (k: string) => $(`[data-n="${k}"]`);
    const pkt = $('[data-pkt]')!;
    const status = $('[data-status]') as HTMLElement;
    const doc = $('[data-doc]')!;
    const scan = $('[data-scan]')!;
    const drop = paint($('[data-drop]'))!;
    const lines = root.querySelectorAll('[data-json-line]');
    const btn = $('[data-sync]') as HTMLButtonElement;

    // The default loop never leaves the machine.
    const tl = gsap.timeline({ repeat: -1, repeatDelay: 1.4 });
    say(tl, status, 'drop a file', C.ink);
    tl.set(lines, { opacity: 0.35 })
      .fromTo(doc, { y: -40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' })
      .to(drop, { stroke: col(C.t2), duration: 0.3 }, '<0.3')
      .to(drop, { stroke: col(C.line), duration: 0.6 }, '>0.4');
    say(tl, status, 'a local vision model reads the invoice', C.t1, '<');
    travel(tl, pkt, p('dm'), 0.35, '<', C.t1);
    glow(tl, n('model'), C.t1, '>', 1.4);
    tl.set(scan, { opacity: 1, y: 0 }, '<').to(scan, { y: 78, duration: 0.7, ease: 'sine.inOut', repeat: 2, yoyo: true }, '<');
    tl.set(scan, { opacity: 0 });
    travel(tl, pkt, p('mj'), 0.35, '>', C.t1);
    say(tl, status, 'structured data · re-prompt once if malformed', C.t2, '<');
    glow(tl, n('json'), C.t2, '>', 1.6);
    tl.to(lines, { opacity: 1, duration: 0.15, stagger: 0.12 }, '<');
    tl.to(pkt, { opacity: 0, duration: 0.2 }, '<');
    tl.to(doc, { opacity: 0, duration: 0.4 }, '>0.6');
    tl.to(lines, { opacity: 0.35, duration: 0.4 }, '<');

    playWhenVisible(root, tl);

    // Syncing happens only when asked.
    btn.addEventListener('click', () => {
      btn.disabled = true;
      setBusy(root, true);
      const s = gsap.timeline({
        onComplete: () => {
          btn.disabled = false;
          setBusy(root, false);
        },
      });
      s.set(lines, { opacity: 1 });
      say(s, status, 'sending the extracted results over MCP', C.t3);
      s.to([$('[data-mcp-wire]'), $('[data-sheets]')], { opacity: 1, duration: 0.3 });
      travel(s, pkt, p('mcp'), 0.7, '>', C.t3);
      glow(s, n('sheets'), C.t3, '>', 0.8);
      say(s, status, 'synced to Google Sheets', C.t3, '<');
      s.to(pkt, { opacity: 0, duration: 0.2 }, '<');
      s.to([$('[data-mcp-wire]'), $('[data-sheets]')], { opacity: 0.5, duration: 0.5 }, '>0.4');
    });
  });
</script>
