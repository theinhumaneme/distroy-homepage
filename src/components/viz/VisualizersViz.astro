---
// Illustrative shapes only: no real activity or workout data is drawn here.
const route =
  'M40 168 C70 150 84 112 118 104 S170 128 196 96 S236 40 276 52 S330 110 360 96 S404 46 440 60 S500 120 478 152 S420 176 392 160';
const bars = [34, 52, 46, 61, 58, 72, 40, 66, 78, 70, 86, 92];
const elev = 'M20 70 L60 60 L100 64 L140 44 L180 30 L220 38 L260 22 L300 34 L340 26 L380 46 L420 40 L460 58 L500 52 L540 64';
---

<div class="viz vz" data-viz="visualizers">
  <div class="vz-card">
    <p class="vz-h mono"><span style="--c:var(--t5)">activity-visualizer</span><span class="faint">route · privacy zones · elevation</span></p>
    <svg viewBox="0 0 520 250" role="img" aria-label="Illustration: a route draws itself with a moving marker. Circles at the start and finish mark privacy zones that hide those locations.">
      <defs>
        <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="6" stroke="rgba(255,138,128,.45)" stroke-width="2" />
        </pattern>
      </defs>
      <path d={route} fill="none" stroke="rgba(124,196,255,.12)" stroke-width="6" stroke-linecap="round" />
      <path d={route} fill="none" stroke="var(--t5)" stroke-width="2.4" stroke-linecap="round" data-route />
      <circle cx="40" cy="168" r="26" fill="url(#hatch)" stroke="var(--t4)" stroke-opacity=".6" data-zone />
      <circle cx="392" cy="160" r="26" fill="url(#hatch)" stroke="var(--t4)" stroke-opacity=".6" data-zone />
      <text x="40" y="210" text-anchor="middle" class="sub">privacy zone</text>
      <circle r="6" fill="var(--ink)" data-head style="filter:drop-shadow(0 0 8px var(--t5))" />
      <g transform="translate(-10 160)">
        <path d={elev} fill="none" stroke="rgba(238,237,232,.3)" stroke-width="1.4" data-elev />
      </g>
    </svg>
  </div>
  <div class="vz-card">
    <p class="vz-h mono"><span style="--c:var(--t3)">training story</span><span class="faint">weekly volume · records</span></p>
    <svg viewBox="0 0 520 170" role="img" aria-label="Illustration: weekly training volume bars rise, a trend line draws over them and a star marks a personal record.">
      {bars.map((b, i) => <rect x={24 + i * 40} y={150 - b * 1.4} width="26" height={b * 1.4} rx="5" fill="var(--t3)" fill-opacity={0.25 + (i / bars.length) * 0.6} data-bar />)}
      <path
        d={`M37 ${150 - bars[0] * 1.4} ` + bars.map((b, i) => `L${37 + i * 40} ${150 - b * 1.4 - 8}`).join(' ')}
        fill="none"
        stroke="var(--ink)"
        stroke-width="1.4"
        stroke-dasharray="2 4"
        data-trend
      />
      <text x={37 + 11 * 40} y={150 - bars[11] * 1.4 - 18} text-anchor="middle" style="fill:var(--t3);font-size:14px" data-pr>★ PR</text>
    </svg>
  </div>
</div>

<style>
  .vz {
    display: grid;
    gap: 1px;
    padding: 0;
  }
  .vz-card {
    padding: 16px 16px 8px;
  }
  .vz-card + .vz-card {
    border-top: 1px solid var(--line);
  }
  .vz-h {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.7rem;
    margin-bottom: 6px;
  }
  .vz-h span:first-child {
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .vz-h span:first-child::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c);
  }
</style>

<script>
  import { gsap, playWhenVisible } from '../../scripts/viz';

  document.querySelectorAll<HTMLElement>('[data-viz="visualizers"]').forEach((root) => {
    const route = root.querySelector<SVGPathElement>('[data-route]')!;
    const elev = root.querySelector<SVGPathElement>('[data-elev]')!;
    const head = root.querySelector('[data-head]')!;
    const len = route.getTotalLength();
    const elen = elev.getTotalLength();
    const bars = root.querySelectorAll('[data-bar]');
    const trend = root.querySelector('[data-trend]')!;

    const tl = gsap.timeline({ repeat: -1, repeatDelay: 1.2 });
    tl.set(route, { strokeDasharray: len, strokeDashoffset: len })
      .set(elev, { strokeDasharray: elen, strokeDashoffset: elen })
      .set(bars, { scaleY: 0, transformOrigin: '50% 100%' })
      .set(trend, { opacity: 0 })
      .set(root.querySelector('[data-pr]'), { opacity: 0, y: 6 })
      .from(root.querySelectorAll('[data-zone]'), { scale: 0, transformOrigin: '50% 50%', duration: 0.6, ease: 'back.out(2)', stagger: 0.15 })
      .to(route, { strokeDashoffset: 0, duration: 3.2, ease: 'sine.inOut' }, '<')
      .to(head, { duration: 3.2, ease: 'sine.inOut', motionPath: { path: route, align: route, alignOrigin: [0.5, 0.5] } }, '<')
      .to(elev, { strokeDashoffset: 0, duration: 3.2, ease: 'sine.inOut' }, '<')
      .to(bars, { scaleY: 1, duration: 0.8, ease: 'expo.out', stagger: 0.07 }, '<0.6')
      .to(trend, { opacity: 1, duration: 0.6 }, '>-0.2')
      .to(root.querySelector('[data-pr]'), { opacity: 1, y: 0, duration: 0.5, ease: 'back.out(3)' }, '<0.2')
      .to({}, { duration: 1.4 });

    playWhenVisible(root, tl);
  });
</script>
