---
import VizFrame from './VizFrame.astro';
import Node from './Node.astro';
const fields = ['topic', 'research', 'code', 'article', 'diagrams', 'errors[]'];
---

<VizFrame name="graph" status="PipelineState ← topic" caption="illustrative · every stage reads and writes one typed PipelineState">
  <div class="viz-canvas">
    <svg viewBox="0 0 560 304" role="img" aria-label="Diagram: research and teaching, then code generation with a bounded JSON repair loop, then writing, then a separate Mermaid validation tool step with a bounded fix loop back to writing, then the finished article. The stages share one typed state.">
      <path class="wire" data-p="e1" d="M170 66 H210" />
      <path class="wire" data-p="e2" d="M330 66 H370" />
      <path class="wire" data-p="e3" d="M445 92 V150" />
      <path class="wire" data-p="out" d="M370 176 H330" />
      <path class="wire dash" data-p="rep" d="M245 40 C245 12 295 12 295 40" />
      <path class="wire dash" data-p="fix" d="M520 176 C556 176 556 66 520 66" />
      <text class="wl" x="270" y="22" text-anchor="middle" style="fill:var(--t3)">json repair ≤ 4</text>
      <text class="wl" x="548" y="125" text-anchor="end" style="fill:var(--t4)">fix ≤ 5</text>

      <Node id="rt" x={20} y={40} w={150} label="research_teaching" sub="agent" kind="ai" />
      <Node id="code" x={210} y={40} w={120} label="code" sub="generates code" kind="ai" />
      <Node id="write" x={370} y={40} w={150} label="writing" sub="reuses code verbatim" kind="ai" />
      <Node id="mv" x={370} y={150} w={150} label="mermaid_validation" sub="mmdc · tool node" />
      <Node id="out" x={180} y={150} w={150} label="article.md" sub="→ Hugo static site" kind="ok" />

      <g>
        <rect class="state" x="20" y="232" width="500" height="68" rx="12" />
        <text x="36" y="254" class="lbl">PipelineState</text>
        <text x="504" y="254" text-anchor="end" class="sub" data-endpoint>endpoint: hosted API</text>
        {
          fields.map((f, i) => (
            <g data-field-chip={f} transform={`translate(${36 + i * 77} 266)`}>
              <rect class="chip" width="70" height="22" rx="6" />
              <text x="35" y="15" text-anchor="middle">
                {f}
              </text>
            </g>
          ))
        }
      </g>

      <circle class="pkt" r="4.5" cx="0" cy="0" data-pkt style="opacity:0" />
    </svg>
  </div>
</VizFrame>

<style>
  .state {
    fill: rgb(var(--wash-rgb) / 0.02);
    stroke: var(--line);
  }
  .chip {
    fill: transparent;
    stroke: var(--viz-edge);
  }
  [data-p='rep'] {
    stroke: color-mix(in oklab, var(--t3) 60%, transparent);
  }
  [data-p='fix'] {
    stroke: color-mix(in oklab, var(--t4) 60%, transparent);
  }
</style>

<script>
  import { gsap, C, col, tint, paint, playWhenVisible, glow, travel, say } from '../../scripts/viz';

  document.querySelectorAll<HTMLElement>('[data-viz="graph"]').forEach((root) => {
    const $ = (s: string) => root.querySelector(s);
    const p = (k: string) => $(`[data-p="${k}"]`);
    const n = (k: string) => $(`[data-n="${k}"]`);
    const pkt = $('[data-pkt]')!;
    const status = $('[data-status]') as HTMLElement;
    const endpoint = $('[data-endpoint]')!;
    const chips = root.querySelectorAll('[data-field-chip] rect');
    const chip = (f: string) => $(`[data-field-chip="${f}"] rect`);
    // a stage writing its field into the shared state
    const fill = (f: string, color: string, at: gsap.Position = '<') =>
      tl.to(paint(chip(f)), { stroke: col(color), fill: tint(color, 0.22), duration: 0.35 }, at);

    const tl = gsap.timeline({ repeat: -1, repeatDelay: 1 });
    let local = false;
    tl.eventCallback('onRepeat', () => {
      local = !local;
      endpoint.textContent = local ? 'endpoint: local · vLLM / LM Studio' : 'endpoint: hosted API';
    });

    say(tl, status, 'PipelineState ← topic', C.ink);
    fill('topic', C.ink, '>');
    glow(tl, n('rt'), C.t1, '>0.2', 0.5);
    say(tl, status, 'research & teaching agent', C.t1, '<');
    fill('research', C.t1);
    travel(tl, pkt, p('e1'), 0.45, '>', C.t1);
    glow(tl, n('code'), C.t3, '>', 0.2);
    say(tl, status, 'code agent → malformed JSON envelope', C.t4, '<');
    travel(tl, pkt, p('rep'), 0.7, '<', C.t3);
    say(tl, status, 'repair prompt · attempt 2/4 → ok', C.t2);
    glow(tl, n('code'), C.t2, '<', 0.3);
    fill('code', C.t3);
    travel(tl, pkt, p('e2'), 0.45, '>', C.t1);
    glow(tl, n('write'), C.t1, '>', 0.3);
    say(tl, status, 'writing stage reuses the code verbatim', C.t1, '<');
    fill('article', C.t1);
    travel(tl, pkt, p('e3'), 0.45, '>', C.t1);
    glow(tl, n('mv'), C.t4, '>', 0.3);
    say(tl, status, 'mmdc: diagram failed to render', C.t4, '<');
    fill('errors[]', C.t4);
    travel(tl, pkt, p('fix'), 0.8, '>', C.t4);
    glow(tl, n('write'), C.t3, '>', 0.2);
    say(tl, status, 'smallest-change fix · 1/5', C.t3, '<');
    travel(tl, pkt, p('e3'), 0.45, '>', C.t1);
    glow(tl, n('mv'), C.t2, '>', 0.3);
    say(tl, status, 'mmdc: valid', C.t2, '<');
    fill('diagrams', C.t5);
    travel(tl, pkt, p('out'), 0.45, '>', C.t2);
    glow(tl, n('out'), C.t2, '>', 0.8);
    say(tl, status, 'article written · Hugo-ready Markdown', C.t2, '<');
    tl.to(pkt, { opacity: 0, duration: 0.3 }, '<');
    tl.to(chips, { stroke: col(C.line), fill: col('transparent'), duration: 0.5 }, '>0.6');

    playWhenVisible(root, tl);
  });
</script>
