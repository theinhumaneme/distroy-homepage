---
const fields = ['topic', 'research', 'code', 'article', 'diagrams', 'errors[]'];
---

<div class="viz" data-viz="graph">
  <p class="viz-status" data-status>PipelineState ← topic</p>
  <svg viewBox="0 0 560 400" role="img" aria-label="Diagram: a LangGraph pipeline. Research and teaching, then code with a JSON repair loop, then writing, then Mermaid validation with a fix loop back to writing, then a published article. All agents share one typed state.">
    <path class="wire" data-p="e1" d="M170 106 L205 106" />
    <path class="wire" data-p="e2" d="M335 106 L370 106" />
    <path class="wire" data-p="e3" d="M445 132 L445 200" />
    <path class="wire dash" data-p="fix" d="M520 226 C556 226 556 106 520 106" style="stroke:color-mix(in oklab, var(--t4) 55%, transparent)" />
    <path class="wire" data-p="out" d="M370 226 L322 226" />
    <path class="wire dash" data-p="rep" d="M246 80 C246 44 294 44 294 80" style="stroke:color-mix(in oklab, var(--t3) 55%, transparent)" />
    <text x="270" y="40" text-anchor="middle" style="fill:var(--t3)">json repair ≤ 4</text>
    <text x="548" y="170" text-anchor="end" style="fill:var(--t4)">fix ≤ 5</text>

    <g><rect class="box" data-n="rt" x="20" y="80" width="150" height="52" rx="12" /><text class="lbl" x="95" y="103" text-anchor="middle">research_teaching</text><text class="sub" x="95" y="119" text-anchor="middle">agent</text></g>
    <g><rect class="box" data-n="code" x="205" y="80" width="130" height="52" rx="12" /><text class="lbl" x="270" y="103" text-anchor="middle">code</text><text class="sub" x="270" y="119" text-anchor="middle">source of truth</text></g>
    <g><rect class="box" data-n="write" x="370" y="80" width="150" height="52" rx="12" /><text class="lbl" x="445" y="103" text-anchor="middle">writing</text><text class="sub" x="445" y="119" text-anchor="middle">embeds code verbatim</text></g>
    <g><rect class="box" data-n="mv" x="370" y="200" width="150" height="52" rx="12" /><text class="lbl" x="445" y="223" text-anchor="middle">mermaid_validation</text><text class="sub" x="445" y="239" text-anchor="middle">mmdc · tool node</text></g>
    <g><rect class="box" data-n="out" x="152" y="200" width="170" height="52" rx="12" /><text class="lbl" x="237" y="223" text-anchor="middle">article.md</text><text class="sub" x="237" y="239" text-anchor="middle">→ Hugo static site</text></g>

    <g>
      <rect x="20" y="290" width="500" height="92" rx="14" fill="rgba(255,255,255,.02)" stroke="rgba(238,237,232,.1)" />
      <text x="38" y="316" class="lbl">PipelineState</text>
      <text x="502" y="316" text-anchor="end" class="sub" data-endpoint>endpoint: hosted API</text>
      {
        fields.map((f, i) => (
          <g data-field-chip={f} transform={`translate(${38 + i * 80} 334)`}>
            <rect width="72" height="28" rx="7" fill="rgba(255,255,255,.03)" stroke="rgba(238,237,232,.12)" />
            <text x="36" y="18" text-anchor="middle">{f}</text>
          </g>
        ))
      }
    </g>

    <circle class="pkt" r="5.5" cx="0" cy="0" data-pkt style="opacity:0" />
  </svg>
</div>

<script>
  import { gsap, C, playWhenVisible, glow, travel, say } from '../../scripts/viz';

  document.querySelectorAll<HTMLElement>('[data-viz="graph"]').forEach((root) => {
    const $ = (s: string) => root.querySelector(s);
    const p = (k: string) => $(`[data-p="${k}"]`);
    const n = (k: string) => $(`[data-n="${k}"]`);
    const pkt = $('[data-pkt]')!;
    const status = $('[data-status]') as HTMLElement;
    const endpoint = $('[data-endpoint]')!;
    const chip = (f: string) => $(`[data-field-chip="${f}"] rect`);
    const light = (f: string, color: string, at: gsap.Position = '<') =>
      tl.to(chip(f), { stroke: color, fill: gsap.utils.interpolate('#101017', color, 0.2), duration: 0.35 }, at);

    const tl = gsap.timeline({ repeat: -1, repeatDelay: 1 });
    let local = false;
    tl.eventCallback('onRepeat', () => {
      local = !local;
      endpoint.textContent = local ? 'endpoint: local · vLLM / LM Studio' : 'endpoint: hosted API';
    });

    say(tl, status, 'PipelineState ← topic', C.ink);
    light('topic', C.ink, '>');
    tl.set(pkt, { opacity: 0, x: 95, y: 106 });
    glow(tl, n('rt'), C.t1, '>0.2', 0.5);
    say(tl, status, 'research & teaching agent', C.t1, '<');
    light('research', C.t1);
    travel(tl, pkt, p('e1'), 0.45);
    glow(tl, n('code'), C.t3, '>', 0.2);
    say(tl, status, 'code agent → malformed JSON envelope', C.t4, '<');
    travel(tl, pkt, p('rep'), 0.7, '<');
    say(tl, status, 'repair prompt · attempt 2/4 → ok', C.t2);
    glow(tl, n('code'), C.t2, '<', 0.3);
    light('code', C.t3);
    travel(tl, pkt, p('e2'), 0.45);
    glow(tl, n('write'), C.t1, '>', 0.3);
    say(tl, status, 'writing agent embeds code verbatim', C.t1, '<');
    light('article', C.t1);
    travel(tl, pkt, p('e3'), 0.45);
    glow(tl, n('mv'), C.t4, '>', 0.3);
    say(tl, status, 'mmdc: diagram failed to render', C.t4, '<');
    light('errors[]', C.t4);
    travel(tl, pkt, p('fix'), 0.8);
    glow(tl, n('write'), C.t3, '>', 0.2);
    say(tl, status, 'smallest-change fix · 1/5', C.t3, '<');
    travel(tl, pkt, p('e3'), 0.45);
    glow(tl, n('mv'), C.t2, '>', 0.3);
    say(tl, status, 'mmdc: valid', C.t2, '<');
    light('diagrams', C.t5);
    travel(tl, pkt, p('out'), 0.45);
    glow(tl, n('out'), C.t2, '>', 0.8);
    say(tl, status, 'published · prose, code and diagrams in sync', C.t2, '<');
    tl.to(pkt, { opacity: 0, duration: 0.3 }, '<');
    tl.to(root.querySelectorAll('[data-field-chip] rect'), { stroke: 'rgba(238,237,232,.12)', fill: 'rgba(255,255,255,.03)', duration: 0.5 }, '>0.6');

    playWhenVisible(root, tl);
  });
</script>
