---
import VizFrame from './VizFrame.astro';
import Node from './Node.astro';
---

<VizFrame name="rag" status="question → query cache" caption="illustrative · a repeated question is answered from the cache">
  <div class="viz-canvas">
    <svg viewBox="0 0 560 264" role="img" aria-label="Diagram: a resident's question checks the query cache. On a miss, context is retrieved from the knowledge base and the LLM writes a plain-language answer, which is cached while the knowledge base grows around what residents ask. On a hit, the cache answers directly.">
      <path class="wire" data-p="qc" d="M140 176 H200" />
      <path class="wire" data-p="miss" d="M260 150 V76" />
      <path class="wire" data-p="kr" d="M160 50 H200" />
      <path class="wire" data-p="rl" d="M320 50 H370" />
      <path class="wire" data-p="la" d="M480 76 V150" />
      <path class="wire" data-p="hit" d="M320 176 H420" />
      <path class="wire dash" data-p="wb" d="M480 202 C480 250 260 250 260 202" />

      <text class="wl" x="266" y="117">miss</text>
      <text class="wl" x="370" y="180" text-anchor="middle">hit</text>
      <text class="wl" x="370" y="242" text-anchor="middle">cache write</text>

      <Node id="kb" x={20} y={24} w={140} label="knowledge base" sub="grows with demand" kind="data" />
      <Node id="ret" x={200} y={24} w={120} label="retrieve" sub="top-k context" kind="data" />
      <Node id="llm" x={370} y={24} w={170} label="LLM" sub="OpenAI · LangChain" kind="ai" />
      <Node id="q" x={20} y={150} w={120} label="question" sub="from a resident" />
      <Node id="cache" x={200} y={150} w={120} label="query cache" sub="hit or miss" kind="cache" />
      <Node id="ans" x={420} y={150} w={120} label="answer" sub="plain language" kind="ok" />

      <text x="90" y="16" text-anchor="middle" class="grow" data-grow style="opacity:0">+ new topic</text>
      <circle class="pkt" r="4.5" cx="0" cy="0" data-pkt style="opacity:0" />
    </svg>
  </div>
</VizFrame>

<style>
  .grow {
    fill: var(--t5);
    font-size: 11px;
  }
</style>

<script>
  import { gsap, C, playWhenVisible, glow, travel, say } from '../../scripts/viz';

  document.querySelectorAll<HTMLElement>('[data-viz="rag"]').forEach((root) => {
    const $ = (s: string) => root.querySelector(s);
    const p = (k: string) => $(`[data-p="${k}"]`);
    const n = (k: string) => $(`[data-n="${k}"]`);
    const pkt = $('[data-pkt]')!;
    const status = $('[data-status]') as HTMLElement;
    const grow = $('[data-grow]')!;
    const tl = gsap.timeline({ repeat: -1, repeatDelay: 1 });

    const miss = (label: string) => {
      say(tl, status, `${label} → cache miss`, C.t3);
      glow(tl, n('q'), C.ink, '<', 0.2);
      travel(tl, pkt, p('qc'), 0.45, '<', C.ink);
      glow(tl, n('cache'), C.t3, '>', 0.3);
      travel(tl, pkt, p('miss'), 0.5, '<', C.t3);
      say(tl, status, 'retrieving context from the knowledge base', C.t5);
      glow(tl, n('kb'), C.t5, '<', 0.2);
      travel(tl, pkt, p('kr'), 0.45, '<', C.t5);
      glow(tl, n('ret'), C.t5, '>', 0.2);
      say(tl, status, 'generating a grounded answer', C.t1);
      travel(tl, pkt, p('rl'), 0.4, '>', C.t1);
      glow(tl, n('llm'), C.t1, '>', 0.5);
      travel(tl, pkt, p('la'), 0.45, '>0.5', C.t1);
      glow(tl, n('ans'), C.t2, '>', 0.4);
      say(tl, status, 'answer cached · the knowledge base grows', C.t2, '<');
      travel(tl, pkt, p('wb'), 0.8, '>0.1', C.t3);
      glow(tl, n('cache'), C.t3, '>', 0.2);
      glow(tl, n('kb'), C.t5, '<', 0.4);
      tl.fromTo(grow, { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' }, '<');
      tl.to(grow, { opacity: 0, duration: 0.4 }, '>0.6');
      tl.to(pkt, { opacity: 0, duration: 0.2 }, '<');
    };
    const hit = () => {
      say(tl, status, 'the same question again → cache hit', C.t2, '>0.4');
      glow(tl, n('q'), C.ink, '<', 0.2);
      travel(tl, pkt, p('qc'), 0.4, '<', C.ink);
      glow(tl, n('cache'), C.t2, '>', 0.3);
      travel(tl, pkt, p('hit'), 0.5, '<', C.t2);
      glow(tl, n('ans'), C.t2, '>', 0.4);
      say(tl, status, 'served from the cache, no retrieval needed', C.t2, '<');
      tl.to(pkt, { opacity: 0, duration: 0.3 }, '>0.4');
    };

    miss('a new question');
    hit();

    playWhenVisible(root, tl);
  });
</script>
