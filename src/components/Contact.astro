---
import ChapterHead from './ChapterHead.astro';
import { contact, person, sources } from '../data/content';

const links = sources.filter((s) => s.url);
---

<section id="contact" class="chapter contact" data-stage="contact" data-field="5" data-field-level="0.35" aria-labelledby="contact-title">
  <div class="wrap">
    <ChapterHead id="contact" color="var(--t2)">
      <span slot="title" id="contact-title">{contact.title}</span>
      {contact.text}
    </ChapterHead>
    <div class="cta-row">
      <a class="btn primary big" href={`mailto:${person.email}`}>{person.email} <span class="arr">→</span></a>
      <a class="btn" href={person.linkedin} target="_blank" rel="noopener">LinkedIn <span class="arr">↗</span></a>
      <a class="btn" href={person.github} target="_blank" rel="noopener">GitHub <span class="arr">↗</span></a>
      <a class="btn" href={person.resume} download>Resume <span class="arr">↓</span></a>
    </div>
  </div>
</section>

<footer class="foot" aria-labelledby="links-title">
  <div class="wrap">
    <h2 id="links-title" class="mono">Project links</h2>
    <ol>
      {
        links.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener">
              {s.label}
            </a>
            <span class="faint"> · {s.detail}</span>
          </li>
        ))
      }
    </ol>
    <div class="eot">
      <p class="mono faint small">© 2026 {person.name} · Built with Astro and GSAP · The search runs in your browser</p>
      <p class="mono eot-t" aria-hidden="true">&lt;|endoftext|&gt;</p>
    </div>
  </div>
</footer>

<style>
  .contact {
    padding-bottom: clamp(72px, 12vh, 140px);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn.big {
    height: 58px;
    padding: 0 24px;
    font-size: var(--fs-body-s);
  }

  .foot {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(6, 6, 9, 0.6), var(--bg));
    padding-block: 56px 40px;
  }
  .foot h2 {
    font-size: var(--fs-micro);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tr-mono);
    color: var(--ink-3);
    margin-bottom: 16px;
  }
  .foot ol {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 260px;
    column-gap: 40px;
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }
  .foot li {
    break-inside: avoid;
    padding: 5px 0;
  }
  .foot a {
    color: var(--ink);
    border-bottom: 1px solid var(--line-2);
  }
  .foot a:hover {
    border-color: var(--t2);
  }
  .eot {
    margin-top: 44px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
  }
  .eot-t {
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  .small {
    font-size: var(--fs-micro);
  }
</style>
