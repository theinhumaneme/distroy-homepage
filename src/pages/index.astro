---
import Base from '../layouts/Base.astro';
import '../styles/homepage.css';
import Hud from '../components/Hud.astro';
import Hero from '../components/Hero.astro';
import Cases from '../components/Cases.astro';
import Query from '../components/Query.astro';
import More from '../components/More.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import TokenPet from '../components/TokenPet.astro';
---

<Base
  title="Kalyan Mudumby · AI, Backend & Infrastructure Engineer"
  description="Kalyan Mudumby builds AI systems, backend applications and infrastructure: city-service chatbots, digital libraries, deployment tools and interactive data visualizations."
>
  <script is:inline slot="head">
    // Landing at the top: hold the hero back so the intro in Hero.astro can
    // play it in. The timeout shows everything anyway if that script never runs.
    try {
      if (!location.hash && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('intro');
        setTimeout(() => document.documentElement.classList.remove('intro'), 2500);
      }
    } catch {}
  </script>
  <div class="homepage">
  <canvas id="field" aria-hidden="true"></canvas>
  <div class="vignette" aria-hidden="true"></div>
  <Hud />
  <main id="main">
    <Hero />
    <Cases />
    <Experience />
    <Skills />
    <More />
    <About />
    <Query />
  </main>
  <Contact />
  <TokenPet />
  </div>
</Base>

<style is:global>
  #field {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }
  /* on paper the vignette would wash the field out; keep it light */
  :root[data-theme='light'] .vignette {
    opacity: 0.35;
  }
  .vignette {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(140% 100% at 50% 45%, transparent 55%, rgb(var(--bg-rgb) / 0.5) 100%),
      linear-gradient(180deg, rgb(var(--bg-rgb) / 0) 70%, rgb(var(--bg-rgb) / 0.6));
  }
  main {
    position: relative;
    z-index: 2;
  }
</style>

<script>
  import { initMotion } from '../scripts/motion';
  initMotion();
</script>
