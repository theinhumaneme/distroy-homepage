---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Hud from '../../../components/Hud.astro';
import PostList from '../../../components/PostList.astro';
import { existsSync } from 'node:fs';
import { blogCopy, hero, person } from '../../../data/content';
import { coverOf, getPosts, postDate, postPath, type Post } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { path: postPath(post) },
    props: { post, more: [...posts.slice(i + 1), ...posts.slice(0, i)].slice(0, 3) },
  }));
}

interface Props {
  post: Post;
  more: Post[];
}
const { post, more } = Astro.props;
const { Content } = await render(post);
const cover = coverOf(post);
const hasResume = existsSync(new URL('../../../../public/kalyan-mudumby-resume.pdf', import.meta.url));
const { title, description, date, tags } = post.data;
---

<Base title={`${title} · ${person.name}`} description={description}>
  <Hud base="/" />
  <main id="main" class="post">
    <article class="wrap" aria-labelledby="post-title">
      <header class="post-head">
        <p class="crumbs mono" data-reveal>
          <a class="link" href="/blog/"><span aria-hidden="true">←</span> {blogCopy.back}</a>
          <time datetime={date.toISOString()}>{postDate(date)}</time>
        </p>
        <h1 id="post-title" class="post-title" data-reveal>{title}</h1>
        {description && <p class="lede" data-reveal data-reveal-delay="0.08">{description}</p>}
        <div class="meta" data-reveal data-reveal-delay="0.12">
          {tags.length > 0 && <div class="chips">{tags.map((t) => <span class="chip">{t}</span>)}</div>}
        </div>
      </header>

      {cover && <Image class="cover" src={cover} alt="" widths={[640, 1024, 1360]} sizes="(max-width: 1360px) 100vw, 1360px" loading="eager" />}

      <div class="prose">
        <Content />
      </div>

      <aside class="author" aria-label="About the author">
        <p class="who">
          Written by <a href="/">{person.name}</a>, {person.role}. {hero.availability}
        </p>
        <p class="reach">
          <a class="link" href="/#work">Selected work <span aria-hidden="true">→</span></a>
          <a class="link" href={`mailto:${person.email}`}>Email</a>
          {hasResume && <a class="link" href={person.resume} download>Resume <span aria-hidden="true">↓</span></a>}
        </p>
      </aside>
    </article>

    {
      more.length > 0 && (
        <aside class="wrap more" aria-labelledby="more-title">
          <h2 id="more-title" class="more-title">{blogCopy.all}</h2>
          <PostList posts={more} />
          <p class="all">
            <a class="link" href="/blog/">{blogCopy.all} <span aria-hidden="true">→</span></a>
          </p>
        </aside>
      )
    }
  </main>
</Base>

<style>
  .post {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--hud-h) + clamp(40px, 8vh, 96px));
    padding-bottom: clamp(72px, 12vh, 160px);
  }
  .post-head,
  .more,
  .author {
    max-width: 760px;
  }
  /* about 70–75 characters a line at body size; code and figures may run wider */
  .prose {
    max-width: 36em;
  }
  .prose :global(:is(pre, figure, table, .mermaid, img)) {
    max-width: min(760px, 100%);
  }
  .author {
    display: grid;
    gap: 14px;
    margin-top: clamp(48px, 8vh, 80px);
    padding-top: 24px;
    border-top: 1px solid var(--line-2);
  }
  .author .who {
    max-width: 62ch;
    color: var(--ink-2);
    line-height: 1.6;
  }
  .author .who a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-3);
    text-underline-offset: 3px;
  }
  .author .reach {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
  }
  .post-head {
    display: grid;
    gap: 20px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  .post-title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-head);
    letter-spacing: var(--tr-head);
    line-height: 1.05;
    text-wrap: balance;
  }
  .meta {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .cover {
    width: 100%;
    max-width: 760px;
    height: auto;
    margin-top: clamp(28px, 5vh, 48px);
    border-radius: 14px;
    border: 1px solid var(--line);
  }
  .more {
    margin-top: clamp(64px, 10vh, 120px);
  }
  .more-title {
    margin-bottom: 18px;
    font-family: var(--f-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-medium);
    color: var(--ink-3);
  }
  .all {
    margin-top: 24px;
  }

  /* Rendered Markdown ------------------------------------------------------ */
  .prose {
    margin-top: clamp(36px, 6vh, 64px);
    color: var(--ink-2);
    line-height: 1.72;
    overflow-wrap: break-word;
  }
  .prose :global(> * + *) {
    margin-top: 1.15em;
  }
  .prose :global(:is(h2, h3, h4)) {
    color: var(--ink);
    font-weight: var(--fw-head);
    line-height: 1.2;
    text-wrap: balance;
    scroll-margin-top: calc(var(--hud-h) + 24px);
  }
  .prose :global(h2) {
    margin-top: 2.4em;
    font-size: var(--fs-title);
    letter-spacing: var(--tr-snug);
  }
  .prose :global(h3) {
    margin-top: 2em;
    font-size: var(--fs-title-s);
    letter-spacing: var(--tr-snug);
  }
  .prose :global(h4) {
    margin-top: 1.8em;
    font-size: var(--fs-body);
  }
  .prose :global(:is(h2, h3, h4) + *) {
    margin-top: 0.7em;
  }
  .prose :global(p) {
    text-wrap: pretty;
  }
  .prose :global(strong) {
    color: var(--ink);
    font-weight: var(--fw-medium);
  }
  .prose :global(a:not(.btn, .post-card)) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-3);
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 0.2s;
  }
  .prose :global(a:not(.btn, .post-card):hover) {
    text-decoration-color: var(--t2);
  }
  .prose :global(:is(ul, ol)) {
    padding-left: 1.3em;
  }
  .prose :global(li + li) {
    margin-top: 0.4em;
  }
  .prose :global(li::marker) {
    color: var(--ink-3);
  }
  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: 1.1em;
    border-left: 1px solid var(--line-3);
    color: var(--ink-2);
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line-2);
    margin-block: 2.4em;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--line);
  }
  .prose :global(:not(pre) > code) {
    font-family: var(--f-mono);
    font-size: 0.86em;
    padding: 0.12em 0.36em;
    border-radius: 5px;
    color: var(--ink);
    background: var(--bg-2);
    border: 1px solid var(--line);
  }
  .prose :global(pre) {
    padding: 16px 18px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-1) !important;
    overflow-x: auto;
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .prose :global(pre code) {
    font-family: var(--f-mono);
  }
  .prose :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--fs-body-s);
  }
  .prose :global(:is(th, td)) {
    padding: 8px 14px 8px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    color: var(--ink);
    font-weight: var(--fw-medium);
  }
  /* Hugo shortcodes, rewritten by src/lib/hugo.ts */
  .prose :global(.mermaid) {
    margin-inline: 0;
    padding: 18px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-1);
    overflow-x: auto;
  }
  .prose :global(.mermaid svg) {
    display: block;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }
  .prose :global(.post-alert) {
    padding: 14px 16px;
    border-radius: 10px;
    border: 1px solid color-mix(in oklab, var(--t3) 35%, transparent);
    background: color-mix(in oklab, var(--t3) 6%, transparent);
  }
  .prose :global(.post-alert > * + *) {
    margin-top: 0.6em;
  }
  .prose :global(.post-card) {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: var(--bg-1);
    transition: border-color 0.2s;
  }
  .prose :global(.post-card:hover) {
    border-color: var(--line-3);
  }
  .prose :global(.pc-k) {
    font-size: var(--fs-micro);
    color: var(--ink-3);
  }
  .prose :global(.pc-t) {
    color: var(--ink);
    font-weight: var(--fw-medium);
  }
  .prose :global(.pc-l) {
    font-size: var(--fs-body-s);
  }
  .prose :global(.btn) {
    height: 40px;
    vertical-align: middle;
  }
</style>

<script>
  import { initMotion } from '../../../scripts/motion';
  initMotion();

  // Draw the post's mermaid blocks once one is near the viewport; posts
  // without diagrams never load mermaid.
  const blocks = [...document.querySelectorAll<HTMLElement>('.prose code.language-mermaid')];
  if (blocks.length) {
    const io = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const { default: mermaid } = await import('mermaid');
        const css = getComputedStyle(document.documentElement);
        const v = (name: string) => css.getPropertyValue(name).trim();
        mermaid.initialize({
          startOnLoad: false,
          theme: 'base',
          fontFamily: v('--f-mono'),
          themeVariables: {
            darkMode: true,
            fontSize: '13px',
            background: v('--bg-1'),
            primaryColor: v('--bg-3'),
            primaryTextColor: v('--ink'),
            primaryBorderColor: v('--ink-4'),
            secondaryColor: v('--bg-2'),
            tertiaryColor: v('--bg-1'),
            lineColor: v('--ink-3'),
            textColor: v('--ink-2'),
            clusterBkg: v('--bg-2'),
            clusterBorder: v('--ink-4'),
            edgeLabelBackground: v('--bg-1'),
          },
        });
        for (const [i, code] of blocks.entries()) {
          const { svg } = await mermaid.render(`mermaid-${i}`, code.textContent ?? '');
          const fig = document.createElement('figure');
          fig.className = 'mermaid';
          fig.setAttribute('role', 'img');
          fig.setAttribute('aria-label', 'Diagram');
          fig.innerHTML = svg;
          code.closest('pre')?.replaceWith(fig);
        }
      },
      { rootMargin: '600px 0px' },
    );
    blocks.forEach((b) => io.observe(b));
  }
</script>
